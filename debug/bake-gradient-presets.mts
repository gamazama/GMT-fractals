/** The fit tolerance, OKLab ΔE. A design decision, so a constant: `--check` must judge the data
 *  file by the same number it was baked at, and a CLI flag would let the two disagree. */
const TARGET = 0.02;
/** How far past the last feasible span the search keeps looking. More can only find fewer
 *  stops, never more; this bake runs offline, so it is generous. */
const MISS_SLACK = 32;
const BIAS = [0.2, 0.26, 0.32, 0.38, 0.44, 0.5, 0.56, 0.62, 0.68, 0.74, 0.8];

